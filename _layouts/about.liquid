---
layout: default
---
<div class="post portfolio-home">
  <article>
    <section class="home-section" id="about">
      <h2 class="section-heading"><a href="#about">about</a></h2>
      <div class="section-content about-hero-content">{{ content }}</div>
    </section>

    {% if site.data.publications %}
      <section class="home-section" id="publications">
        <h2 class="section-heading"><a href="#publications">publications</a></h2>
        <div class="section-content">{% include publications_list.liquid %}</div>
      </section>
    {% endif %}

    {% if site.data.presentations %}
      <section class="home-section" id="presentations">
        <h2 class="section-heading"><a href="#presentations">presentations</a></h2>
        <div class="section-content">{% include presentations_list.liquid %}</div>
      </section>
    {% endif %}

    {% if site.data.projects %}
      <section class="home-section" id="projects">
        <h2 class="section-heading"><a href="#projects">projects</a></h2>
        <div class="section-content">{% include projects_list.liquid %}</div>
      </section>
    {% endif %}

    {% if site.news %}
      <section class="home-section" id="news">
        <h2 class="section-heading"><a href="#news">news</a></h2>
        <div class="section-content">
          {% include news.liquid limit=true %}
        </div>
      </section>
    {% endif %}

    <section class="home-section" id="contact">
      <h2 class="section-heading"><a href="#contact">contact</a></h2>
      <div class="section-content contact-section">
        <p class="contact-note">I’m always open to conversations and collaborations around medical imaging, artificial intelligence, and computational medicine. Whether you’re interested in discussing research, exploring a potential collaboration, or simply exchanging ideas at the intersection of technology and healthcare, feel free to get in touch.
</p>
        {% assign socials = site.data.socials %}
        <div class="contact-links">
          {% if socials.email %}<div><span class="contact-label">email</span><span><a href="mailto:{{ socials.email }}">{{ socials.email }}</a></span></div>{% endif %}
          {% if socials.github_username %}
            {% assign github_url = socials.github_username %}
            {% unless github_url contains '://' %}{% assign github_url = socials.github_username | prepend: 'https://github.com/' %}{% endunless %}
            <div><span class="contact-label">github</span><span><a href="{{ github_url }}" target="_blank" rel="noopener noreferrer">{{ github_url | remove: 'https://' }}</a></span></div>
          {% endif %}
          {% if socials.linkedin_username %}
            {% assign linkedin_url = socials.linkedin_username %}
            {% unless linkedin_url contains '://' %}{% assign linkedin_url = socials.linkedin_username | prepend: 'https://www.linkedin.com/in/' %}{% endunless %}
            <div><span class="contact-label">linkedin</span><span><a href="{{ linkedin_url }}" target="_blank" rel="noopener noreferrer">{{ linkedin_url | remove: 'https://' }}</a></span></div>
          {% endif %}
          {% if socials.scholar_url %}<div><span class="contact-label">google scholar</span><span><a href="{{ socials.scholar_url }}" target="_blank" rel="noopener noreferrer">author profile</a></span></div>{% endif %}
        </div>
      </div>
    </section>
  </article>
</div>
