<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% assign show_brand = true %}
      {% if page.permalink == '/' or page.url contains '/blog/' %}
        {% assign show_brand = false %}
      {% endif %}
      {% if show_brand %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          OA<span>.</span>
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}" data-section-nav="home">
            <a class="nav-link" href="{{ '/#about' | relative_url }}" data-section-link="home">
              about
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <li class="nav-item" data-section-nav="publications">
            <a class="nav-link" href="{{ '/#publications' | relative_url }}" data-section-link="publications">publications</a>
          </li>
          <li class="nav-item" data-section-nav="projects">
            <a class="nav-link" href="{{ '/#projects' | relative_url }}" data-section-link="projects">projects</a>
          </li>
          <li class="nav-item" data-section-nav="news">
            <a class="nav-link" href="{{ '/#news' | relative_url }}" data-section-link="news">news</a>
          </li>
          <li class="nav-item" data-section-nav="contact">
            <a class="nav-link" href="{{ '/#contact' | relative_url }}" data-section-link="contact">contact</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{ '/blog/' | relative_url }}">blog</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{ '/assets/pdf/cv.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer">cv</a>
          </li>
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toggle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <!-- system: half-filled circle -->
                <svg
                  id="light-toggle-system"
                  class="theme-icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"></path>
                </svg>
                <!-- dark: crescent moon -->
                <svg
                  id="light-toggle-dark"
                  class="theme-icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
                <!-- light: sun -->
                <svg
                  id="light-toggle-light"
                  class="theme-icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="4.2"></circle>
                  <path
                    d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4l1.4-1.4M18 6l1.4-1.4"
                  ></path>
                </svg>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>

{% if page.permalink == '/' %}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var navItems = Array.from(document.querySelectorAll("[data-section-nav]"));
      var sections = [
        { id: "home", element: document.querySelector(".post-header") },
        { id: "publications", element: document.getElementById("publications") },
        { id: "projects", element: document.getElementById("projects") },
        { id: "news", element: document.getElementById("news") },
        { id: "contact", element: document.getElementById("contact") },
      ].filter(function (section) {
        return section.element;
      });

      function activate(sectionId) {
        navItems.forEach(function (item) {
          item.classList.toggle("active", item.getAttribute("data-section-nav") === sectionId);
        });
      }

      function updateActiveSection() {
        var current = "home";
        sections.forEach(function (section) {
          if (section.element.getBoundingClientRect().top <= 120) {
            current = section.id;
          }
        });
        activate(current);
      }

      window.addEventListener("scroll", updateActiveSection, { passive: true });
      updateActiveSection();
    });
  </script>
{% endif %}
